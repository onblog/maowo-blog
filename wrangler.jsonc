{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maowo-blog",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],

  // 变量由部署环境管理：不要用仓库里的默认值覆盖 Cloudflare Dashboard
  // 上配置的 SITE_URL（生产域名只在部署侧出现）。
  "keep_vars": true,

  // 日志与跟踪：生产问题排查的第一手证据，默认全开。
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  // 静态资源免费且不计 Worker 请求额度；未命中的路径回落到 Worker（Hono 处理页面与 /api/*）。
  "assets": {
    "directory": "./public"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miao-blog-db",
      // 由 `wrangler d1 create miao-blog-db` 生成，创建后填在这里。
      "database_id": "d6877df7-9066-4605-bddb-6f6b47aedea8",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2_MEDIA",
      "bucket_name": "miao-blog-media"
    }
  ],

  // 可选能力：评论 AI 审核与摘要生成。不用 AI 的用户可以在控制台删掉这段绑定，
  // 代码里所有 AI 调用都已经做了「绑定不存在就跳过」的降级。
  "ai": {
    "binding": "AI"
  },

  "dev": {
    "port": 8789
  },

  "vars": {
    "ENV": "development",
    // 站点语言：部署时定死，运行时不做切换（zh 默认 / en）。
    "SITE_LOCALE": "zh",
    // SITE_URL 决定 OAuth 的 redirect_uri，必须与 GitHub OAuth App 注册的回调地址一致。
    // 这里只放**本地开发默认值**；生产值由 Cloudflare Worker 的环境变量提供
    // （Settings → Variables and Secrets），所以仓库里不出现线上域名。
    "SITE_URL": "http://127.0.0.1:8789",
    // GitHub OAuth 的 CLIENT_ID 与 SECRET 都走 secret（本地 .dev.vars）。
    // ⚠️ 不要在这里写空字符串：vars 会覆盖同名 secret。
    // 后台账号密码也不在这里：它们存在 D1 的 `admin_credentials` 表里（迁移 0007），
    // 首次读取时播种为 admin/admin，登录后强制改密；改账号密码走后台 /admin/account。
  },

  // 域名绑定不在仓库里声明：统一在 Cloudflare Dashboard 的
  // Worker → Settings → Domains & Routes 维护（见 README 的部署章节）。

  "env": {
    "production": {
      "name": "maowo-blog",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "miao-blog-db",
          "database_id": "d6877df7-9066-4605-bddb-6f6b47aedea8",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "R2_MEDIA", "bucket_name": "miao-blog-media" }],
      "ai": { "binding": "AI" },
      // 域名绑定在 Dashboard 维护（见上文注释）。
      "vars": {
        "ENV": "production",
        "SITE_LOCALE": "zh"
        // SITE_URL 不在这里：生产值由 Cloudflare Worker 的环境变量提供。
      }
    }
  }
}
