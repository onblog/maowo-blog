{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maowo-blog",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],

  // 静态资源里有一件**生成物**：public/vendor/mermaid.min.js（mermaid 图表库，见
  // scripts/build-mermaid.mjs）。它不进仓库（3 MB 的第三方 bundle），但必须在
  // `wrangler deploy` 上传静态资源**之前**就存在，否则线上 /vendor/mermaid.min.js 是 404，
  // 图表退化成一段源码。
  //
  // 写在 build 里就等于把这件事交给所有部署路径统一处理：本地 `pnpm deploy`、
  // 直接 `npx wrangler deploy --env production`、以及 Workers Builds 的自动部署，
  // 都会先跑一遍这个命令。别把它挪回 npm script —— 手动步骤一定会被漏掉。
  "build": {
    "command": "node scripts/build-mermaid.mjs"
  },

  // 变量由部署环境管理：不要用仓库里的默认值覆盖 Cloudflare Dashboard
  // 上配置的 SITE_URL（生产域名只在部署侧出现）。
  "keep_vars": true,

  // 只接受自定义域名访问：关掉 `*.workers.dev` 与预览 URL。
  // 不写这两行时 wrangler 会自动开启它们 —— 站点会多出一份公开入口，
  // 同一份内容两个域名可访问（预览 URL 还会绕过自定义域的缓存与 WAF）。
  "workers_dev": false,
  "preview_urls": false,

  // 日志与跟踪：生产问题排查的第一手证据，默认全开。
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  // 静态资源免费且不计 Worker 请求额度；未命中的路径回落到 Worker（Hono 处理页面与 /api/*）。
  "assets": {
    "directory": "./public"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miao-blog-db",
      // 由 `wrangler d1 create miao-blog-db` 生成，创建后填在这里。
      "database_id": "d6877df7-9066-4605-bddb-6f6b47aedea8",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2_MEDIA",
      "bucket_name": "miao-blog-media"
    }
  ],

  // 可选能力：评论 AI 审核与摘要生成。不用 AI 的用户可以在控制台删掉这段绑定，
  // 代码里所有 AI 调用都已经做了「绑定不存在就跳过」的降级。
  "ai": {
    "binding": "AI"
  },

  "dev": {
    "port": 8789
  },

  "vars": {
    // ⚠️ Workers Builds 跑的是**不带 `--env production` 的 `wrangler deploy`**，
    // 也就是说这一节里的 vars 会被原样当成生产变量。所以这里只放"两种环境取值相同"的东西，
    // 任何只适合本地开发的默认值（尤其 SITE_URL）都别写进来 —— 它会被静默带上生产。
    //
    // SITE_URL 因此不在仓库里：本地写在 `.dev.vars`（gitignore，见 .dev.vars.example），
    // 生产写在 Cloudflare Dashboard 的 Worker 变量里，由下面 keep_vars 保住。
    //
    // 站点语言：部署时定死，运行时不做切换（zh 默认 / en）。
    "SITE_LOCALE": "zh",
    // GitHub OAuth 的 CLIENT_ID 与 SECRET 都走 secret（本地 .dev.vars）。
    // ⚠️ 不要在这里写空字符串：vars 会覆盖同名 secret。
    // 后台账号密码也不在这里：它们存在 D1 的 `admin_credentials` 表里（迁移 0007），
    // 首次读取时播种为 admin/admin，登录后强制改密；改账号密码走后台 /admin/account。
  },

  // 域名绑定不在仓库里声明：统一在 Cloudflare Dashboard 的
  // Worker → Settings → Domains & Routes 维护（见 README 的部署章节）。

  "env": {
    "production": {
      "name": "maowo-blog",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "miao-blog-db",
          "database_id": "d6877df7-9066-4605-bddb-6f6b47aedea8",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "R2_MEDIA", "bucket_name": "miao-blog-media" }],
      "ai": { "binding": "AI" },
      // 域名绑定在 Dashboard 维护（见上文注释）。
      "vars": {
        "SITE_LOCALE": "zh"
        // SITE_URL 不在这里：生产值写在 Dashboard 的 Worker 变量里（keep_vars 保住它）。
      }
    }
  }
}
